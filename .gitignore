# OS / editor
Thumbs.db
Desktop.ini
.DS_Store
*.swp
.idea/
.vscode/
*.log

# local env / junk
node_modules/
.cache/
dist/
*.tmp

# WorkBuddy 工作区数据（会话记忆等，不入库）
/.workbuddy-ai/

# ad-hoc root probes (use js/sim/_*.mjs for engine probes)
/_nan.mjs
/_smoke_p1.mjs
/_trace.mjs
/_trace_goal.mjs

# local match recordings / FMM reference clips (do not upload)
/rec/

# local scratch: video-comparison probes, baseline/calibration dumps (do not upload)
# ⚠ 用 `/.tmp-*` 而非 `/.tmp-*/`：探针产物九成是**文件**（`.tmp-verify.txt`），
#   目录形式带尾斜杠只匹配目录，这些文件因此一直显示为未跟踪的 `??`。
/.tmp-*

# local health-check dumps & one-off fix scripts
/artifacts/
/scripts/_*.py
